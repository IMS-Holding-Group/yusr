# نسخ إلى .env محلياً أو ضبط في لوحة Render

# ─── Backend (yusr-api) ───
# Render free: data/yusr.db (inside backend/, writable)
# With persistent disk: /var/data/yusr.db
DATABASE_PATH=data/yusr.db
CORS_ORIGINS=https://yusr-web.onrender.com,http://localhost:8080
FLASK_DEBUG=false
PORT=5000

# ─── Flutter Web (بناء محلي عبر build-flutter-web.ps1) ───
API_BASE_URL=https://yusr-api.onrender.com
